# Copy to .env (Docker) or /etc/ssh-honeypot/env (systemd install) and fill in.
# Never commit the real file.

# --- Telegram notification (optional) ----------------------------------------
# Sent when a session reaches the fake shell (only with auth.policy other than
# "reject"). At most one message per telegram.batch_interval seconds.
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Name shown in Telegram messages (defaults to the machine hostname).
HONEYPOT_NAME=

# --- Dashboard authentication (optional, recommended) ------------------------
# The dashboard only listens on 127.0.0.1 and is meant to be reached through
# an SSH tunnel. Setting both adds HTTP basic auth as a second layer.
HONEYPOT_DASHBOARD_USER=
HONEYPOT_DASHBOARD_PASSWORD=
